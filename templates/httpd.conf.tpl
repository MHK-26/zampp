# Generated by zampp — do not edit. Re-rendered on every start from templates/httpd.conf.tpl
ServerRoot "{{serverRoot}}"
DefaultRuntimeDir "{{run}}"
PidFile "{{run}}/httpd.pid"
Mutex file:{{run}} default

Listen 127.0.0.1:{{httpPort}}
{{#if tls}}Listen 127.0.0.1:{{httpsPort}}{{/if}}

{{#each modules}}LoadModule {{name}} "{{path}}"
{{/each}}

ServerName localhost
ServerAdmin admin@localhost
ServerTokens Prod
ServerSignature Off
TraceEnable Off
HostnameLookups Off
Timeout 300
KeepAlive On

ErrorLog "{{logs}}/apache-error.log"
LogLevel warn
LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
CustomLog "{{logs}}/apache-access.log" combined

TypesConfig "{{mimeTypes}}"
AddType application/x-httpd-php .php
DirectoryIndex index.php index.html index.htm

<Directory />
    AllowOverride None
    Require all denied
</Directory>

DocumentRoot "{{www}}"
<Directory "{{www}}">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>

{{#if phpSocket}}
<FilesMatch "\.php$">
    SetHandler "proxy:unix:{{phpSocket}}|fcgi://localhost/"
</FilesMatch>
{{/if}}

<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

# Default host: the zampp welcome page and tools at http://localhost:{{httpPort}}/
# It must be the FIRST VirtualHost so unknown Host headers land here, not on a site.
<VirtualHost 127.0.0.1:{{httpPort}}>
    ServerName localhost
    ServerAlias 127.0.0.1 ::1 *.localhost
    DocumentRoot "{{www}}"
    ErrorLog "{{logs}}/apache-error.log"
    CustomLog "{{logs}}/apache-access.log" combined
</VirtualHost>
{{#if tls}}
<VirtualHost 127.0.0.1:{{httpsPort}}>
    ServerName localhost
    ServerAlias 127.0.0.1 ::1 *.localhost
    DocumentRoot "{{www}}"
    {{#if localhostCert}}
    SSLEngine on
    SSLCertificateFile "{{localhostCert}}"
    SSLCertificateKeyFile "{{localhostKey}}"
    {{/if}}
    ErrorLog "{{logs}}/apache-error.log"
    CustomLog "{{logs}}/apache-access.log" combined
</VirtualHost>
{{/if}}

<IfModule ssl_module>
SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
SSLCipherSuite HIGH:!aNULL:!MD5
SSLSessionCache "shmcb:{{run}}/ssl_scache(512000)"
SSLSessionCacheTimeout 300
</IfModule>

IncludeOptional "{{sitesEtc}}/*.conf"

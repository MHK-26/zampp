; Generated by zampp for PHP {{version}}
[global]
pid = {{run}}/php-fpm-{{version}}.pid
error_log = {{logs}}/php-fpm-{{version}}.log
daemonize = no

[www]
listen = {{socket}}
listen.mode = 0660
pm = dynamic
pm.max_children = 12
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 4
pm.max_requests = 500
catch_workers_output = yes
clear_env = no
php_admin_value[error_log] = {{logs}}/php-{{version}}-error.log
php_admin_flag[log_errors] = on
